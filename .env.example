MOODLE_BASE_URL=https://moodle.technikum-wien.at
MOODLE_DASHBOARD_URL=https://moodle.technikum-wien.at/my/
MOODLE_USERNAME=
MOODLE_PASSWORD=

BROWSER_HEADLESS=false
BROWSER_STATE_DIR=state/browser
OUTPUT_DIR=output
DATA_DIR=data
STATE_DIR=state

# Optional quiz subagent backend. Leave empty to use `codex exec` when installed.
# Set to `off` to create packet/screenshot artifacts without asking a subagent.
SUBAGENT_SOLVER_COMMAND=
SUBAGENT_TIMEOUT_SECONDS=300

# Optional study document generator backend. Leave empty to use `codex exec` when installed.
# By default, generator failures fail the run so debugging stays visible.
# Set STUDY_DOC_GENERATOR_REQUIRED=false only if a deterministic fallback is acceptable.
STUDY_DOC_GENERATOR_COMMAND=
STUDY_DOC_TIMEOUT_SECONDS=180
STUDY_DOC_LANGUAGE=de
STUDY_DOC_GENERATOR_REQUIRED=true
STUDY_DOC_CODEX_REASONING_EFFORT=medium
# STUDY_DOC_CODEX_MODEL=gpt-5.4
STUDY_DOC_CITATION_STYLE=endnotes
STUDY_DOC_DEFAULT_MODE=auto
