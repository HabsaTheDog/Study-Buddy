{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "subtitle",
    "course",
    "topic",
    "audience",
    "generated_at",
    "learning_objectives",
    "key_concepts",
    "sections",
    "practice_checkpoints",
    "common_pitfalls",
    "source_notes",
    "risk_flags"
  ],
  "properties": {
    "title": { "type": "string" },
    "subtitle": { "type": ["string", "null"] },
    "course": { "type": ["string", "null"] },
    "topic": { "type": "string" },
    "audience": { "type": "string" },
    "generated_at": { "type": "string" },
    "learning_objectives": {
      "type": "array",
      "items": { "type": "string" }
    },
    "key_concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "explanation", "citations"],
        "properties": {
          "term": { "type": "string" },
          "explanation": { "type": "string" },
          "citations": {
            "type": "array",
            "items": { "$ref": "#/$defs/citation" }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "summary", "details", "worked_examples", "citations"],
        "properties": {
          "heading": { "type": "string" },
          "summary": { "type": "string" },
          "details": {
            "type": "array",
            "items": { "type": "string" }
          },
          "worked_examples": {
            "type": "array",
            "items": { "$ref": "#/$defs/worked_example" }
          },
          "citations": {
            "type": "array",
            "items": { "$ref": "#/$defs/citation" }
          }
        }
      }
    },
    "practice_checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answer", "citations"],
        "properties": {
          "question": { "type": "string" },
          "answer": { "type": "string" },
          "citations": {
            "type": "array",
            "items": { "$ref": "#/$defs/citation" }
          }
        }
      }
    },
    "common_pitfalls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pitfall", "correction", "citations"],
        "properties": {
          "pitfall": { "type": "string" },
          "correction": { "type": "string" },
          "citations": {
            "type": "array",
            "items": { "$ref": "#/$defs/citation" }
          }
        }
      }
    },
    "source_notes": {
      "type": "array",
      "items": { "$ref": "#/$defs/citation" }
    },
    "risk_flags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "kind", "url", "path", "page", "section"],
      "properties": {
        "title": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["pdf", "moodle_page", "assignment", "local_file"]
        },
        "url": { "type": ["string", "null"] },
        "path": { "type": ["string", "null"] },
        "page": { "type": ["integer", "null"] },
        "section": { "type": ["string", "null"] }
      }
    },
    "worked_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "solution", "citations"],
      "properties": {
        "problem": { "type": "string" },
        "solution": { "type": "string" },
        "citations": {
          "type": "array",
          "items": { "$ref": "#/$defs/citation" }
        }
      }
    }
  }
}
